# Experiential Labs API Key (Required for AI analysis)
EXPLABS_API_KEY=your_experiential_labs_api_key_here

# Experiential Labs Model Name (Optional, default: openrouter-free)
EXPLABS_MODEL=openrouter-free

# Server Port (Render automatically sets PORT)
PORT=5000

# Allowed CORS Origins (Comma separated for specific origins, or omit / '*' for all origins)
# Example: https://ai-project-analyzer.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*
